APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync = تُنفَّذ الوظيفة داخل دورة الطلب (تطويرٌ فقط).
# redis = الإنتاج: يلزمه redis-server وعاملان على الأقل
#         (kafaat-queue@1..2) وعاملُ استيراد (kafaat-import@1).
# database = بديلٌ يعمل بلا Redis إطلاقاً — الوظائف في جدول `jobs`.
#         أبطأ تحت الحمل، لكنه يُشغّل الاستيراد الخلفي بلا بنيةٍ إضافية.
# ⚠ لا تتركه sync في الإنتاج: استيراد عشرة آلاف صفّ ينقطع مع المتصفّح،
#   ورسائل التأكيد تُبطئ حفظ كل مشارك بانتظار بوّابة الرسائل.
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# phpredis أسرع لكنه امتداد C يحتاج تصريفاً على الخادم.
# predis نقيّ PHP ومُثبَّت مع الحزمة — استعمله إن لم يكن الامتداد متاحاً.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── الإنتاج: تصلّب المرحلة ٠ (أُضيفت مع إصلاحات النشر) ──
# عناوين الوسطاء العكسيين في الـ DMZ (فارغ = لا نثق بأحد). لا تستخدم '*'.
TRUSTED_PROXIES=
# مصادر CORS المسموحة صراحةً (مفصولة بفواصل). في الإنتاج: نطاق الواجهة الحقيقي.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
# بذر المدير في الإنتاج فقط: بلا هذه المتغيّرة لا يُنشأ أي حساب (يُطلب تغييرها عند أول دخول).
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_EMAIL=admin@kafaat.local

# ── بحيرة التقارير ──────────────────────────────────────────────────
# قاعدةٌ ثانية مستقلّة تتراكم فيها مخرجات المنصّة لتقرأها منصّةٌ أخرى.
# معطّلة افتراضياً؛ تفعيلُها قرارٌ صريح ويحتاج إعادة نشر (config:cache).
# التهيئة: deploy/lake/README.md — والعقد: docs/LAKE_CONTRACT_v1.md
LAKE_ENABLED=false

# فلفل HMAC لسكّ المعرّف البديل. ٣٢ محرفاً عشوائياً فأكثر.
# لا يغادر خادم التطبيق، ولا يُكتب في البحيرة. تغييرُه يقطع استمراريةَ
# الشخص عبر الأحداث السابقة — يُغيَّر بقرارٍ موثّق لا بالخطأ.
LAKE_PEPPER=

# النشر الانتقائي — كلٌّ يُفتح بمراجعةٍ مكتوبة لا بتبديل سطر:
LAKE_PUBLISH_NARRATIVE=false          # نصّ التقرير الحرّ
LAKE_PUBLISH_PARTICIPANT_CODE=false   # رمز المشارك (يكشف القطاع وترتيب الالتحاق)
LAKE_PUBLISH_DOCUMENTS=false          # المستندات المُصيَّرة

# اتصال البحيرة. نقلُها إلى خادمٍ مستقلّ = تغيير DB_LAKE_HOST وحده.
DB_LAKE_HOST=127.0.0.1
DB_LAKE_PORT=5432
DB_LAKE_DATABASE=kafaat_lake
DB_LAKE_USERNAME=lake_writer
DB_LAKE_PASSWORD=
DB_LAKE_DDL_USERNAME=lake_owner
DB_LAKE_DDL_PASSWORD=
DB_LAKE_SSLMODE=prefer

# مفاتيح تشغيلية لها قيم افتراضية معقولة — تُضبط عند الحاجة فقط:
# LAKE_UUID_NAMESPACE=            # فضاء أسماء UUIDv5. تغييرُه يُعيد إرسال كل حدثٍ تاريخيّ صفّاً جديداً.
# LAKE_BATCH_SIZE=500             # عدد الأحداث في دفعة الشحن
# LAKE_MAX_ATTEMPTS=8             # محاولاتٌ قبل عزل الصفّ في الحجر الصحّي
# LAKE_BACKLOG_ALARM=5000         # تراكمٌ فوقه يُسجَّل تنبيه
# LAKE_PARTITION_MONTHS_AHEAD=15  # أشهرٌ تُهيَّأ أقسامُها مُقدَّماً
# LAKE_CONNECTION=pgsql_lake      # اتصال الكتابة
# LAKE_DDL_CONNECTION=pgsql_lake_ddl  # اتصال الهجرات
