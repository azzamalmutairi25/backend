# ════════════════════════════════════════════════════════════
#  إعدادات الإنتاج — تُنسخ إلى /srv/kafaat/shared/.env على خادم التطبيق
#  الصلاحيات: chown kafaat:kafaat  ·  chmod 600   (تحوي مفتاح التشفير)
# ════════════════════════════════════════════════════════════

APP_NAME="مركز تمكين الكفاءات"
APP_ENV=production
# يُولَّد مرة واحدة: php artisan key:generate --show
# ⚠ تغييره يجعل كل البيانات المشفّرة (الأسماء، الهويات، السِيَر) غير قابلة للفكّ.
#   احفظ نسخة منه في خزنة المفاتيح قبل الإطلاق.
APP_KEY=
APP_DEBUG=false
APP_URL=https://kafaat.internal.gov.sa
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar

# ── عنوان بوّابة المشارك العامة ──
# يُبنى عليه رابط الدعوة الذي يصل المشارك برسالة نصية. غيابُه ليس عطلاً
# ظاهراً: config/app.php يسقط إلى http://localhost:5173، و`config:cache`
# يخبز هذا الافتراضي، فيُرسَل لكل مشارك رابطٌ يشير إلى جهازه هو — والسجلّ
# يقول «أُرسلت». لا بدّ أن يكون العنوان الذي يراه المشارك من الإنترنت.
FRONTEND_URL=https://kafaat.gov.sa

# ── عمر رمز الدخول (بالدقائق) ──
# فارغاً تعني: لا ينتهي أبداً. رمزٌ يُلتقط مرّةً من محطّة استقبال مشتركة أو
# عبر XSS يبقى صالحاً إلى الأبد — وزرّ «تسجيل الخروج» في الواجهة يمسح
# المتصفّح ولا يُبطل الرمز على الخادم، فهذا هو الحدّ الوحيد على عمره.
# ٤٨٠ = ثماني ساعات، طول يوم العمل.
SANCTUM_EXPIRATION=480

# ── السجلّات ──
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# ── قاعدة البيانات (الخادم الثالث) ──
DB_CONNECTION=pgsql
DB_HOST=10.10.10.30
DB_PORT=5432
DB_DATABASE=kafaat
DB_USERNAME=kafaat
DB_PASSWORD=

# ── Redis (على خادم التطبيق، مربوط على الواجهة الداخلية) ──
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── المحرّكات: الثلاثة إلى Redis ──
# القاعدة كانت تحمل الجلسة والذاكرة المؤقّتة والطابور معاً: كل طلب يكتب صفّ
# جلسة، وكل رسالة تُرسَل داخل دورة الطلب (sync) فينتظر المستخدم بوّابة الرسائل.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log

# ── خلف الوسيط العكسي ──
# ⚠ إلزامي. بدونه يُفهرَس تقييد المعدّل على عنوان الوسيط: كل المستخدمين
#   وكل المشاركين على البوّابة العامة في دلوٍ واحد ⇒ الخدمة تحجب نفسها.
#   تُقرأ عبر config/security.php فتنجو من config:cache.
TRUSTED_PROXIES=10.10.10.10,10.10.10.20

# سقف الطلبات لكل مستخدم مُصادَق في الدقيقة (٣٠٠ ≈ ٥ طلبات/ثانية للمستخدم)
API_RATE_LIMIT=300

# ── CORS ──
# فارغ عمداً: الواجهة تُخدَم من الأصل نفسه عبر الوسيط، فلا حاجة لـCORS.
# أي قيمة هنا توسّع سطح الهجوم بلا مقابل.
CORS_ALLOWED_ORIGINS=

# ── البريد ──
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=no-reply@kafaat.gov.sa
MAIL_FROM_NAME="${APP_NAME}"

# ── الحساب الأول (يُستعمل عند البذر الأول فقط، ثم يُفرَّغ) ──
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

# ── تكلفة تجزئة كلمة المرور ──
BCRYPT_ROUNDS=12
